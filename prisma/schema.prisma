generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String
  name            String   @default("Admin")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AppConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}

model Party {
  id           String     @id @default(cuid())
  name         String
  type         String     // BUYER or SELLER
  phone        String?
  address      String?    @db.Text
  gstNumber    String?
  paymentTerms Int        @default(0) // days
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  purchases    Purchase[]
  sales        Sale[]
  payments     Payment[]
}

model Purchase {
  id              String   @id @default(cuid())
  commodity       String   // Copper, MS_Scrap, Battery, etc.
  unit            String   // KG, MT, PCS
  quantity        Decimal  @db.Decimal(12, 3)
  rate            Decimal  @db.Decimal(12, 2)
  purchasePrice   Decimal  @db.Decimal(14, 2)
  laborCost       Decimal  @default(0) @db.Decimal(12, 2)
  transportCost   Decimal  @default(0) @db.Decimal(12, 2)
  loadingCost     Decimal  @default(0) @db.Decimal(12, 2)
  miscOverhead    Decimal  @default(0) @db.Decimal(12, 2)
  gstPercent      Decimal  @default(0) @db.Decimal(5, 2)
  gstAmount       Decimal  @default(0) @db.Decimal(12, 2)
  tcsPercent      Decimal  @default(0) @db.Decimal(5, 2)
  tcsAmount       Decimal  @default(0) @db.Decimal(12, 2)
  totalCost       Decimal  @db.Decimal(14, 2)
  partyId         String
  party           Party    @relation(fields: [partyId], references: [id])
  date            DateTime @default(now())
  notes           String?  @db.Text
  batchId         String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  sales           Sale[]
  dealFinances    DealFinance[]

  @@index([commodity])
  @@index([partyId])
  @@index([date])
}

model Sale {
  id            String    @id @default(cuid())
  commodity     String
  unit          String
  quantity      Decimal   @db.Decimal(12, 3)
  rate          Decimal   @db.Decimal(12, 2)
  gstPercent    Decimal   @default(0) @db.Decimal(5, 2)
  gstAmount     Decimal   @default(0) @db.Decimal(14, 2)
  totalAmount   Decimal   @db.Decimal(14, 2)
  bankAmount    Decimal   @db.Decimal(14, 2)
  cashAmount    Decimal   @db.Decimal(14, 2)
  sourceCommodity String? // Bulk item (e.g., MS Scrap) from which this was extracted
  batchId       String? // Link to a specific purchase lot
  purchaseId    String?
  purchase      Purchase? @relation(fields: [purchaseId], references: [id])
  partyId       String
  party         Party     @relation(fields: [partyId], references: [id])
  date          DateTime  @default(now())
  notes         String?   @db.Text
  isPaid        Boolean   @default(false)
  paidDate      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payments      Payment[]
  dealFinances  DealFinance[]

  @@index([commodity])
  @@index([partyId])
  @@index([date])
}

model Payment {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id])
  partyId   String
  party     Party    @relation(fields: [partyId], references: [id])
  amount    Decimal  @db.Decimal(14, 2)
  mode      String   // BANK or CASH
  reference String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([partyId])
}

model Inventory {
  id           String   @id @default(cuid())
  commodity    String   @unique
  unit         String
  quantity     Decimal  @default(0) @db.Decimal(12, 3)
  avgCost      Decimal  @default(0) @db.Decimal(12, 2)
  lastUpdated  DateTime @default(now())
}

model ODAccount {
  id              String          @id @default(cuid())
  bankName        String
  odLimit         Decimal         @db.Decimal(14, 2)
  currentUtilized Decimal         @default(0) @db.Decimal(14, 2)
  interestRate    Decimal         @db.Decimal(5, 2) // annual %
  lastAccrualDate DateTime        @default(now())
  accruedInterest Decimal         @default(0) @db.Decimal(14, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  transactions    ODTransaction[]
}

model ODTransaction {
  id          String    @id @default(cuid())
  accountId   String
  account     ODAccount @relation(fields: [accountId], references: [id])
  amount      Decimal   @db.Decimal(14, 2)
  type        String    // DRAW or REPAY
  description String?
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([accountId])
  @@index([date])
}

model AnalysisSnapshot {
  id        String   @id @default(cuid())
  data      String   @db.LongText
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model MonthlyExpense {
  id          String   @id @default(cuid())
  month       Int
  year        Int
  category    String   // RENT, OD_INTEREST, ELECTRICITY, SALARY, MISC
  amount      Decimal  @db.Decimal(14, 2)
  description String?  @db.Text
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([month, year, category])
  @@index([year])
  @@index([category])
}

model CommitteeInvestment {
  id              String   @id @default(cuid())
  committeeName   String   @default("Father's Committee")
  maturityAmount  Decimal  @db.Decimal(14, 2)
  startDate       DateTime
  maturityDate    DateTime
  totalMonths     Int      @default(13)
  isActive        Boolean  @default(true)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  payments        CommitteePayment[]
}

model CommitteePayment {
  id              String              @id @default(cuid())
  committeeId     String
  committee       CommitteeInvestment @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  month           Int
  year            Int
  amount          Decimal             @db.Decimal(14, 2)
  fundingSource   String              @default("EARNED_MONEY") // OWN_SAVINGS, EARNED_MONEY, OD_MONEY, MIXED
  ownSavingsAmount Decimal            @default(0) @db.Decimal(14, 2)
  earnedMoneyAmount Decimal           @default(0) @db.Decimal(14, 2)
  odMoneyAmount   Decimal             @default(0) @db.Decimal(14, 2)
  odAccountId     String?
  isPaid          Boolean             @default(true)
  date            DateTime            @default(now())
  createdAt       DateTime            @default(now())

  @@unique([committeeId, month, year])
  @@index([committeeId])
  @@index([fundingSource])
  @@index([odAccountId])
}

model InvestmentUse {
  id                String   @id @default(cuid())
  title             String
  category          String   @default("OTHER") // COMMITTEE, BUSINESS_ASSET, PERSONAL, FAMILY, EMERGENCY, MARKET, OTHER
  fundingSource     String   @default("EARNED_MONEY") // OWN_SAVINGS, EARNED_MONEY, OD_MONEY, MIXED
  amount            Decimal  @db.Decimal(14, 2)
  ownSavingsAmount  Decimal  @default(0) @db.Decimal(14, 2)
  earnedMoneyAmount Decimal  @default(0) @db.Decimal(14, 2)
  odMoneyAmount     Decimal  @default(0) @db.Decimal(14, 2)
  expectedReturn    Decimal? @db.Decimal(14, 2)
  expectedReturnDate DateTime?
  odAccountId       String?
  notes             String?  @db.Text
  date              DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([date])
  @@index([category])
  @@index([fundingSource])
  @@index([odAccountId])
}

model DealFinance {
  id                   String        @id @default(cuid())
  dealName             String
  dealType             String        @default("DIRECT_PURCHASE") // DIRECT_PURCHASE, OD_TO_CASH_PURCHASE, PARTNERSHIP, BROKERAGE, RESALE
  status               String        @default("OPEN") // OPEN, CLOSED, CANCELLED
  itemName             String
  quantity             Decimal?      @db.Decimal(12, 3)
  unit                 String?
  purchaseId           String?
  purchase             Purchase?     @relation(fields: [purchaseId], references: [id])
  saleId               String?
  sale                 Sale?         @relation(fields: [saleId], references: [id])
  dealValue            Decimal       @default(0) @db.Decimal(14, 2)
  purchaseCost         Decimal       @default(0) @db.Decimal(14, 2)
  expectedSaleValue    Decimal       @default(0) @db.Decimal(14, 2)
  actualSaleValue      Decimal       @default(0) @db.Decimal(14, 2)
  brokerageAmount      Decimal       @default(0) @db.Decimal(14, 2)
  fundingSource        String        @default("OWN_MONEY") // OWN_MONEY, OD_MONEY, OD_TO_CASH, PARTNER_MONEY, MIXED, BROKERAGE_ONLY
  ownMoneyAmount       Decimal       @default(0) @db.Decimal(14, 2)
  earnedMoneyAmount    Decimal       @default(0) @db.Decimal(14, 2)
  odMoneyAmount        Decimal       @default(0) @db.Decimal(14, 2)
  odToCashAmount       Decimal       @default(0) @db.Decimal(14, 2)
  partnerMoneyAmount   Decimal       @default(0) @db.Decimal(14, 2)
  cashPaidAmount       Decimal       @default(0) @db.Decimal(14, 2)
  onlinePaidAmount     Decimal       @default(0) @db.Decimal(14, 2)
  cashReceivedAmount   Decimal       @default(0) @db.Decimal(14, 2)
  onlineReceivedAmount Decimal       @default(0) @db.Decimal(14, 2)
  shownToParty         String?
  buyerPartyName       String?
  sellerPartyName      String?
  profitShareNotes     String?       @db.Text
  notes                String?       @db.Text
  date                 DateTime      @default(now())
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  partners             DealPartner[]

  @@index([dealType])
  @@index([fundingSource])
  @@index([status])
  @@index([date])
  @@index([purchaseId])
  @@index([saleId])
}

model DealPartner {
  id             String      @id @default(cuid())
  dealId         String
  deal           DealFinance @relation(fields: [dealId], references: [id], onDelete: Cascade)
  partnerName    String
  investedAmount Decimal     @default(0) @db.Decimal(14, 2)
  sharePercent   Decimal     @default(0) @db.Decimal(5, 2)
  expectedReturn Decimal     @default(0) @db.Decimal(14, 2)
  actualReturn   Decimal     @default(0) @db.Decimal(14, 2)
  notes          String?     @db.Text
  createdAt      DateTime    @default(now())

  @@index([dealId])
  @@index([partnerName])
}

model HomeDistribution {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(14, 2)
  recipient   String   // WIFE, SON, OTHER
  description String?  @db.Text
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([date])
}

model VisionMilestone {
  id                String   @id @default(cuid())
  fyYear            Int      @unique // e.g. 2026 = FY 2026-2027 start year
  turnoverTarget    Decimal  @db.Decimal(16, 2) // Revenue target for this FY
  profitTarget      Decimal  @db.Decimal(16, 2) // Net profit target
  valuationTarget   Decimal  @db.Decimal(16, 2) // Company valuation target
  actualTurnover    Decimal? @db.Decimal(16, 2) // Filled in from real data
  actualProfit      Decimal? @db.Decimal(16, 2)
  keyGoals          String?  @db.Text           // JSON array of goal strings
  achievements      String?  @db.Text           // JSON array of achieved items
  notes             String?  @db.Text
  isCompleted       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([fyYear])
}
