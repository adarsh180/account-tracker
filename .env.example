# Database
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google AI
# Keep the real key only in your local .env and Vercel Environment Variables.
GOOGLE_AI_API_KEY="your-google-ai-api-key"

# Primary model first, then fallback models in order.
# If Google has not enabled a listed model for your account, the API route will try the next one.
GOOGLE_AI_MODELS="gemma-4-31b-it,gemma-4-26b-it,gemma-3-27b-it"
